# Optional environment overrides (config file still works via `jagx config`)

# JagX backend
JAGX_API_KEY=jagx-your-key-here
JAGX_BASE_URL=https://jagx-ai-v2.onrender.com

# Bring your own provider (also: jagx config --provider ...)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk_...
NVIDIA_API_KEY=nvapi-...

# Optional integrations (never used unless you ask / pass --allow-social)
RESEND_API_KEY=re_...
RESEND_FROM=you@domain.com
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...
X_BEARER_TOKEN=AAAA...
SOCIAL_WEBHOOK_URL=https://hooks.example.com/jagx
